  "state_file": "state.json",
  "email": {
    "host": "smtp.163.com",
    "port": 465,
    "security": "ssl",
    "sender": "yourname@163.com",
    "recipients": [
      "recipient@example.com"
    ],
    "password_env": "SMTP_PASSWORD",
    "timeout": 20
  }
}
