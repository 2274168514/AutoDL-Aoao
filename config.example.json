{
  "autodl": {
    "token_env": "AUTODL_TOKEN",
    "sub_account": "",
    "app_version": ""
  },
  "targets": [
    {
      "kind": "instance",
      "value": "替换为实例ID或完整名称",
      "min_gpus": null
    }
  ],
  "poll_seconds": 60,
  "timeout_seconds": 20,
  "cooldown_seconds": 300,
